{
  "manifest_version": 3,
  "name": "MORI Browser Bridge（プレビュー）",
  "version": "0.1.5",
  "description": "ChatGPT と Claude の状態・会話タイトル・送信済み依頼の短い抜粋を、この PC の MORI Desk に表示します。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MORI Desk に接続"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "provider-utils.js",
        "adapters/chatgpt.js",
        "adapters/claude.js",
        "observation-controller.js",
        "conversation-metadata.js",
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:23333 ws://127.0.0.1:23334 ws://127.0.0.1:23335 ws://127.0.0.1:23336 ws://127.0.0.1:23337; base-uri 'none'"
  }
}
